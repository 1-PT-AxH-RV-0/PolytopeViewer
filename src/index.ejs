<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title><%= htmlWebpackPlugin.options.title %></title>
  </head>
  <body>
    <!-- 渲染区域 -->
    <canvas class="polytope-renderer" id="polytopeRenderer"></canvas>

    <!-- prettier-ignore -->
    <div class="tabs">
      <!-- 导航栏 -->
      <nav>
        <div class="nav nav-underline nav-justified">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#controlsTab">控制</button>
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#seleOffTab">选择OFF</button>
        </div>
      </nav>
      
      <div class="tab-content">
        <!-- 控制页 -->
        <div class="controls tab-pane fade show active" id="controlsTab">
          <div class="accordion" id="controls">
            
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#propsControl">
                  属性
                </button>
              </h2>
              <div id="propsControl" class="accordion-collapse collapse" data-bs-parent="#controls">
                <div class="accordion-body" style="padding: 1.75em;">
                  <ul class="list-group list-group-flush">
                    <li class="list-group-item"><div>缩放：<div id="scaleFactorSlider"></div></div></li>
                    <li class="list-group-item"><div>面不透明度：<div id="faceOpacitySlider"></div></div></li>
                    <li class="list-group-item"><div>边和顶点尺寸：<div id="wireframeAndVerticesDimSlider"></div></div></li>
                    <li class="list-group-item"><div>投影距离：<div id="projectionDistanceSlider"></div></div></li>
                    <li class="list-group-item"><div>面分离距离：<div id="separationDistSlider"></div></div></li>
                    <li class="list-group-item"><div>面缩放：<div id="faceScaleSlider"></div></div></li>
                    <li class="list-group-item"><div>边缩放：<div id="edgeScaleSlider"></div></div></li>
                  </ul>
                </div>
              </div>
            </div>
            
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#visibilitiesControl">
                  显示状态
                </button>
              </h2>
              <div id="visibilitiesControl" class="accordion-collapse collapse" data-bs-parent="#controls">
                <div class="accordion-body">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="faceVisibleSwitcher" checked />
                    <label class="form-check-label" for="faceVisibleSwitcher">显示面</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="wireframeVisibleSwitcher" checked />
                    <label class="form-check-label" for="wireframeVisibleSwitcher">显示边</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="verticesVisibleSwitcher" checked />
                    <label class="form-check-label" for="verticesVisibleSwitcher">显示顶点</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="axisVisibleSwitcher" checked />
                    <label class="form-check-label" for="axisVisibleSwitcher">显示坐标轴</label>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#rotationsControl">
                  旋转
                </button>
              </h2>
              <div id="rotationsControl" class="accordion-collapse collapse" data-bs-parent="#controls">
                <div class="accordion-body" style="padding: 1.75em;">
                  <ul class="list-group list-group-flush">
                    <li class="list-group-item"><div>XY：<div id="rotXYSlider"></div></div></li>
                    <li class="list-group-item"><div>XZ：<div id="rotXZSlider"></div></div></li>
                    <li class="list-group-item"><div>XW：<div id="rotXWSlider"></div></div></li>
                    <li class="list-group-item"><div>YZ：<div id="rotYZSlider"></div></div></li>
                    <li class="list-group-item"><div>YW：<div id="rotYWSlider"></div></div></li>
                    <li class="list-group-item"><div>ZW：<div id="rotZWSlider"></div></div></li>
                  </ul>
                </div>
              </div>
            </div>
            
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#projMethods">
                  投影方式
                </button>
              </h2>
              <div id="projMethods" class="accordion-collapse collapse" data-bs-parent="#controls">
                <div class="accordion-body">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="perspSwitcher" checked />
                    <label class="form-check-label" for="perspSwitcher">透视投影</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="schleSwitcher" checked disabled />
                    <label class="form-check-label" for="schleSwitcher">施莱格尔投影</label>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#advancedControl">
                  高级
                </button>
              </h2>
              <div id="advancedControl" class="accordion-collapse collapse" data-bs-parent="#controls">
                <div class="accordion-body">
                  <div class="btn-group-vertical advanced-btns">
                    <div class="btn-group">
                      <button id="uploadOff" class="btn btn-outline-primary">上传 OFF</button>
                      <button class="btn btn-outline-primary" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="选择 OFF 文件并加载（仅支持 4D 与 3D）">?</button>
                    </div>
                    <div class="btn-group">
                      <button id="startRecord" class="btn btn-outline-primary">开始录制</button>
                      <button class="btn btn-outline-primary" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="选择 YAML 格式的配置文件并开始录制视频，录制完成后自动下载视频">?</button>
                    </div>
                    <div class="btn-group">
                      <button disiabled id="stopRecord" class="btn btn-outline-primary">结束录制</button>
                      <button class="btn btn-outline-primary" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="结束录制并下载视频">?</button>
                    </div>
                    <div class="btn-group">
                      <button disiabled id="highlightCells" class="btn btn-outline-primary">高亮胞</button>
                      <button class="btn btn-outline-primary" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="从下方的 YAML 编辑器中读取高亮配置然后高亮胞（同时自动隐藏面）">?</button>
                    </div>
                    <div class="btn-group">
                      <button id="highlightFaces" class="btn btn-outline-primary">高亮面</button>
                      <button class="btn btn-outline-primary" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="从下方的 YAML 编辑器中读取高亮配置然后高亮胞面（同时自动隐藏面）（仅可用于3D模式）">?</button>
                    </div>
                  </div>
                  <div id="editor" class="editor"></div>
                </div>
              </div>
            </div>
            
          </div>
          <input type="file" id="fileInput" class="file-input" />
          <input type="file" id="configFileInput" class="config-file-input" />
        </div>
        
        <!-- OFF 选择页 -->
        <div id="seleOffTab" class="sele-off tab-pane fade">
          <div class="accordion" id="offs">

            <!--————————————————————多面体————————————————————-->
            <div class="accordion-item">
              <h1 class="accordion-header">
                <button class="accordion-button collapsed" data-radius data-bs-toggle="collapse" data-bs-target="#polyhedra">
                  多面体
                </button>
              </h1>
              <div id="polyhedra" class="accordion-collapse collapse" data-bs-parent="#offs">
                <div class="accordion-body">
                  <div class="accordion accordion-flush" id="polyhedraOffs">

                    <% for (const sub of htmlWebpackPlugin.options.templateParameters.offCatalog.polyhedra) { %>
                      <div class="accordion-item">
                        <h2 class="accordion-header">
                          <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#<%= sub.id %>">
                            <%= sub.label %>
                          </button>
                        </h2>
                        <div id="<%= sub.id %>" class="accordion-collapse collapse" data-bs-parent="#polyhedraOffs">
                          <div class="accordion-body">
                            <ul class="list-group list-group-flush">

                              <% for (const item of sub.items) { %>
                                <a href="#" data-path="<%= item.path %>"><%= item.name %></a>
                              <% } %>

                            </ul>
                          </div>
                        </div>
                      </div>
                    <% } %>

                  </div>
                </div>
              </div>
            </div>

            <!--————————————————————多胞体————————————————————-->
            <div class="accordion-item">
              <h1 class="accordion-header">
                <button class="accordion-button collapsed" data-radius data-bs-toggle="collapse" data-bs-target="#polychora">
                  多胞体
                </button>
              </h1>
              <div id="polychora" class="accordion-collapse collapse" data-bs-parent="#offs">
                <div class="accordion-body">
                  <div class="accordion accordion-flush" id="polychoraOffs">

                    <% for (const sub of htmlWebpackPlugin.options.templateParameters.offCatalog.polychora) { %>
                      <div class="accordion-item">
                        <h2 class="accordion-header">
                          <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#<%= sub.id %>">
                            <%= sub.label %>
                          </button>
                        </h2>
                        <div id="<%= sub.id %>" class="accordion-collapse collapse" data-bs-parent="#polychoraOffs">
                          <div class="accordion-body">
                            <ul class="list-group list-group-flush">

                              <% for (const item of sub.items) { %>
                                <a href="#" data-path="<%= item.path %>"><%= item.name %></a>
                              <% } %>

                            </ul>
                          </div>
                        </div>
                      </div>
                    <% } %>

                  </div>
                </div>
              </div>
            </div>

            <!-- 无限家族 -->
            <div class="accordion-item">
              <h1 class="accordion-header">
                <button class="accordion-button collapsed" data-radius data-bs-toggle="collapse" data-bs-target="#infFamilies">
                  无限家族
                </button>
              </h1>
              <div id="infFamilies" class="accordion-collapse collapse" data-bs-parent="#offs">
                <div class="accordion-body">
                  <ul class="inf-families-list list-group list-group-flush">
                  
                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="5/2" id="prismN" class="form-control">
                        <span class="input-group-text">角柱</span>
                        <button id="genPrism" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>
                    
                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="5/2" id="antiprismN" class="form-control">
                        <span class="input-group-text">角反角柱</span>
                        <button id="genAntiprism" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>
                    
                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="5" id="trapezohedronN" class="form-control">
                        <span class="input-group-text">方偏方面体</span>
                        <button id="genTrapezohedron" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>
                    
                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="7" id="stephanoidN" class="form-control">
                        <span class="input-group-text">角间</span>
                        <input type="text" value="2" id="stephanoidA" class="form-control">
                        <span class="input-group-text">隔</span>
                        <input type="text" value="3" id="stephanoidB" class="form-control">
                        <span class="input-group-text">冠体</span>
                        <button id="genStephanoid" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>
                    
                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="7/3" id="cupolaN" class="form-control">
                        <span class="input-group-text">角台塔</span>
                        <button id="genCupola" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>
                    
                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="5/2" id="duoprismM" class="form-control">
                        <span class="input-group-text">角</span>
                        <input type="text" value="6" id="duoprismN" class="form-control">
                        <span class="input-group-text">角双角柱</span>
                        <button id="genDuoprism" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>
                    
                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="5/3" id="duoantiprismM" class="form-control">
                        <span class="input-group-text">角</span>
                        <input type="text" value="5" id="duoantiprismN" class="form-control">
                        <span class="input-group-text">角双反角柱</span>
                        <button id="genDuoantiprism" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>

                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="5/3" id="duotegumM" class="form-control">
                        <span class="input-group-text">角</span>
                        <input type="text" value="5" id="duotegumN" class="form-control">
                        <span class="input-group-text">角双罩体</span>
                        <button id="genDuotegum" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>

                    <li class="list-group-item">
                      <div class="input-group input-group-sm">
                        <input type="text" value="9/4" id="pqDigonalDisphenoidPQ" class="form-control">
                        <span class="input-group-text">角二角双楔体</span>
                        <button id="genPqDigonalDisphenoid" class="btn btn-outline-secondary">生成</button>
                      </div>
                    </li>

                  </ul>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- 错误弹窗 -->
    <div class="modal fade" id="errorModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title">错误</h1>
            <button class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" id="errorMsg"></div>
        </div>
      </div>
    </div>

    <!-- 信息显示与加载进度 -->
    <div id="info" class="info"></div>
    <div id="progContainer" class="prog-container"
      ><div id="prog" class="prog"></div
    ></div>
  </body>
</html>
